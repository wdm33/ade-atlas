---
import Base from "../layouts/Base.astro";
import EnforcementCharts from "../components/EnforcementCharts.tsx";
import InvariantSkeleton from "../components/InvariantSkeleton.tsx";
import { manifest, invariants, codemap, headDeltas, clusters, withBase } from "../lib/site-data.ts";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Skeleton view: slimmed nodes (smaller props payload than the full registry)
// and edges filtered to refs that actually resolve, so the graph has no
// dangling endpoints.
const skeletonRules = invariants.rules.map((r) => ({
  id: r.id,
  tier: r.tier,
  family: r.family,
  status: r.status,
  statement: r.statement,
}));
const validIds = new Set(invariants.rules.map((r) => r.id));
const skeletonEdges = invariants.rules.flatMap((r) =>
  r.cross_ref.filter((t) => validIds.has(t)).map((t) => ({ from: r.id, to: t })),
);
const inDeg = new Map<string, number>();
for (const e of skeletonEdges) inDeg.set(e.to, (inDeg.get(e.to) ?? 0) + 1);
const topHubs = [...inDeg.entries()].sort((a, b) => b[1] - a[1]).slice(0, 3);

// Enforcement health is registry-derived (authoritative, always present) rather
// than read from the TRACEABILITY prose summary, whose format varies between
// doc regenerations. Crates fall back to the module inventory if the CODEMAP
// counts table can't be parsed, so the dashboard never shows NaN% / blanks.
const total = invariants.count;
const enforced = invariants.by_status.enforced ?? 0;
const partial = invariants.by_status.partial ?? 0;
const declaredCount = invariants.by_status.declared ?? 0;
const enforcedPct = total ? Math.round((enforced / total) * 100) : null;
const crateCount =
  manifest.counts.crates ??
  new Set(codemap.modules.filter((m) => m.kind === "crate").map((m) => m.name)).size;
const declaredClusters = clusters.clusters.filter((c) => c.status === "declared");

// Trim seconds: "2026-05-30 06:25:21 +0700" -> "2026-05-30 06:25 +0700".
const stamp = (s: string | null) =>
  s ? s.replace(/(\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}):\d{2}/, "$1").trim() : null;
const baselineStamp = stamp(headDeltas.baseline_date);
const headStamp = stamp(headDeltas.head_date);

// ISO ("2026-05-31T04:59:14Z") -> "2026-05-31 04:59 UTC".
const isoShort = (s: string) =>
  s.replace("T", " ").replace(/:\d{2}(\.\d+)?Z?$/, " UTC");
const builtAt = isoShort(manifest.built_at);
// Repo-mode-only: how far the docs lag behind the actual tip.
const live = manifest.live_repo;
const docsLag = live && (live.commits_since_doc_stamp ?? 0) > 0 ? live : null;
const tipDateShort = live ? isoShort(live.tip_date.replace(/([+-]\d{2}:?\d{2})$/, "")) : null;

const stats = [
  { num: crateCount, label: "crates", href: "/modules" },
  { num: manifest.counts.canonical_types, label: "canonical types", href: "/modules" },
  { num: invariants.count, label: "invariant rules", href: "/invariants" },
  { num: manifest.counts.ci_checks, label: "CI checks", href: "/enforcement" },
];
---

<Base active="home" title="Dashboard" description="Authority, invariant, and enforcement map for the replay-first Cardano node.">
  <h1>Ade Atlas</h1>
  <p class="lede">
    A read-only evidence dashboard over the Ade node's authority boundaries, invariants, seams,
    recent changes, and enforcement status. The repo stays the source of truth — this is a
    commit-pinned, regenerated projection of it.
  </p>
  <p class="muted" style="font-size:0.85rem;margin:-0.5rem 0 1.25rem">
    Data as of <strong style="color:var(--fg)">{builtAt}</strong>
    · pinned to ade@<code>{manifest.repo_head}</code>
    {docsLag && (
      <>
        · <span class="badge gap" style="font-size:0.7rem">
          ade docs lag by {docsLag.commits_since_doc_stamp} commit{docsLag.commits_since_doc_stamp === 1 ? "" : "s"}
          {(docsLag.code_commits_since_doc_stamp ?? 0) > 0 ? ` (${docsLag.code_commits_since_doc_stamp} touching crates/)` : ""}
        </span>
      </>
    )}
  </p>

  <div class="grid cols-4">
    {stats.map((st) => (
      <a class="stat" href={withBase(st.href)} style="text-decoration:none;display:block">
        <div class="num">{st.num ?? "—"}</div>
        <div class="label">{st.label}</div>
      </a>
    ))}
  </div>

  <h2>Enforcement health</h2>
  <div class="grid cols-4" style="margin-bottom:1rem">
    <a class="stat" href={withBase("/invariants/?status=enforced")} style="text-decoration:none;display:block"><div class="num" style="color:var(--enforced)">{enforced}</div><div class="label">enforced ({enforcedPct ?? "—"}%)</div></a>
    <a class="stat" href={withBase("/invariants/?status=partial")} style="text-decoration:none;display:block"><div class="num" style="color:var(--partial)">{partial}</div><div class="label">partial</div></a>
    <a class="stat" href={withBase("/invariants/?status=declared")} style="text-decoration:none;display:block"><div class="num" style="color:var(--declared)">{declaredCount}</div><div class="label">declared (open gaps)</div></a>
    <a class="stat" href={withBase("/enforcement/#drift")} style="text-decoration:none;display:block"><div class="num" style="color:#ff7b72">{manifest.drift.soft + manifest.drift.hard}</div><div class="label">drift findings</div></a>
  </div>
  <EnforcementCharts
    client:load
    byStatus={invariants.by_status}
    byTier={invariants.by_tier}
    byFamily={invariants.by_family}
    total={invariants.count}
  />

  <div class="grid cols-2" style="margin-top:1.5rem">
    <div class="card">
      <h3>Latest changes <a href={withBase("/deltas")} style="font-size:0.8rem;font-weight:400">view deltas →</a></h3>
      <dl class="kv">
        <dt>baseline</dt><dd class="mono">{headDeltas.baseline}{baselineStamp && <span class="faint" style="font-weight:400;margin-left:0.55rem;font-size:0.78rem">{baselineStamp}</span>}</dd>
        <dt>HEAD</dt><dd class="mono">{headDeltas.head}{headStamp && <span class="faint" style="font-weight:400;margin-left:0.55rem;font-size:0.78rem">{headStamp}</span>}</dd>
        <dt>commits</dt><dd>{headDeltas.commit_count} · +{headDeltas.lines_added} / -{headDeltas.lines_removed}</dd>
        <dt>rules</dt><dd>{headDeltas.rules_at_baseline} → {headDeltas.rules_at_head} (+{(headDeltas.rules_at_head ?? 0) - (headDeltas.rules_at_baseline ?? 0)})</dd>
        <dt>new rules</dt><dd>{headDeltas.new_rules.map((r) => r.id).join(", ")}</dd>
        {docsLag && (
          <>
            <dt>docs lag</dt>
            <dd>
              <span class="badge gap">+{docsLag.commits_since_doc_stamp} commits since</span>
              <span class="faint" style="margin-left:0.5rem;font-size:0.82rem">
                repo tip ade@<span class="mono">{docsLag.tip_sha}</span>
                {tipDateShort && <> · {tipDateShort}</>}
              </span>
            </dd>
          </>
        )}
      </dl>
    </div>
    <div class="card">
      <h3>Open work</h3>
      {declaredClusters.length > 0 ? (
        <ul style="margin:0;padding-left:1.1rem">
          {declaredClusters.map((c) => (
            <li><a href={withBase(`/clusters#${c.id}`)} class="mono">{c.id}</a> — declared follow-on ({c.follow_ons.length} obligation{c.follow_ons.length === 1 ? "" : "s"})</li>
          ))}
        </ul>
      ) : (
        <p class="muted">No declared follow-on clusters.</p>
      )}
      <p class="muted" style="font-size:0.85rem;margin-bottom:0">
        {declaredCount} declared invariants remain open enforcement gaps. See
        <a href={withBase("/enforcement")}>Enforcement</a>.
      </p>
    </div>
  </div>

  <h2>Invariant skeleton</h2>
  <p class="muted" style="font-size:0.9rem;margin-top:-0.35rem;max-width:78ch">
    {invariants.count} rules, {skeletonEdges.length} cross-references. Hubs by inbound degree —
    {topHubs.map(([id, n], i) => (
      <>
        {i > 0 ? ", " : ""}<a class="mono" href={withBase(`/invariants/${id}`)}>{id}</a>
        <span class="faint"> ({n})</span>
      </>
    ))}
    {topHubs.length > 0 ? " — are the load-bearing vertebrae the rest of the registry anchors to." : ""}
  </p>
  <InvariantSkeleton client:visible rules={skeletonRules} edges={skeletonEdges} basePath={base} />

  <h2>Explore</h2>
  <div class="grid cols-3">
    <a class="card" href={withBase("/modules")} style="display:block">
      <h3>Architecture map</h3>
      <p class="muted" style="margin:0">Modules by BLUE/GREEN/RED, the dependency graph, MUST-NOT rules, and the CI guarding each boundary.</p>
    </a>
    <a class="card" href={withBase("/seams")} style="display:block">
      <h3>Seam explorer</h3>
      <p class="muted" style="margin:0">Where new work can legally attach: ingress pipelines, closed vs extensible registries, frozen contracts.</p>
    </a>
    <a class="card" href={withBase("/invariants")} style="display:block">
      <h3>Invariant explorer</h3>
      <p class="muted" style="margin:0">Search all {invariants.count} rules; trace each to code, tests, CI, and drift.</p>
    </a>
    <a class="card" href={withBase("/enforcement")} style="display:block">
      <h3>Enforcement</h3>
      <p class="muted" style="margin:0">Health counts, true invariants lacking CI, and rules referencing missing tests/scripts.</p>
    </a>
    <a class="card" href={withBase("/clusters")} style="display:block">
      <h3>Clusters</h3>
      <p class="muted" style="margin:0">Cluster/slice history — rules introduced and strengthened, CI added, follow-ons.</p>
    </a>
    <a class="card" href={withBase("/certification")} style="display:block">
      <h3>Certification</h3>
      <p class="muted" style="margin:0">Bounty readiness traced upward to derived and true invariants (targets, not laws).</p>
    </a>
  </div>
</Base>
