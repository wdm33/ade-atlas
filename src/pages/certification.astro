---
import Base from "../layouts/Base.astro";
import StatusBadge from "../components/StatusBadge.astro";
import config from "../../certification.config.json";
import { ruleById, withBase } from "../lib/site-data.ts";

interface Criterion {
  id: string;
  title: string;
  description: string;
  invariants: string[];
}
const criteria = config.criteria as Criterion[];

// Overall readiness across the UNION of referenced invariants (each counted once,
// no double-counting when a rule supports multiple criteria).
const allIds = new Set(criteria.flatMap((c) => c.invariants));
let oEnforced = 0, oPartial = 0, oDeclared = 0, oUnknown = 0;
for (const id of allIds) {
  const r = ruleById(id);
  if (!r) oUnknown++;
  else if (r.status === "enforced") oEnforced++;
  else if (r.status === "partial") oPartial++;
  else oDeclared++;
}
const oTotal = allIds.size;
const oPct = oTotal ? Math.round((oEnforced / oTotal) * 100) : 0;
const pctOf = (n: number) => (oTotal ? (n / oTotal) * 100 : 0);

function readiness(ids: string[]) {
  let enforced = 0, partial = 0, declared = 0, unknown = 0;
  for (const id of ids) {
    const r = ruleById(id);
    if (!r) unknown++;
    else if (r.status === "enforced") enforced++;
    else if (r.status === "partial") partial++;
    else declared++;
  }
  const total = ids.length;
  const label =
    unknown > 0 ? "check refs"
      : declared > 0 ? "partly evidenced"
      : partial > 0 ? "mostly evidenced"
      : "evidenced";
  return { enforced, partial, declared, unknown, total, label };
}
const labelClass: Record<string, string> = {
  "evidenced": "enforced",
  "mostly evidenced": "enforced",
  "partly evidenced": "partial",
  "check refs": "drift",
};
const fullyEvidenced = criteria.filter((c) => readiness(c.invariants).label === "evidenced").length;
---

<Base active="certification" title="Certification Readiness" description="Bounty readiness traced upward to invariants.">
  <h1>Certification Readiness</h1>
  <p class="lede">
    Bounty / certification targets, each traced upward to the derived and true invariants that
    evidence it.
  </p>
  <div class="banner warn">
    <strong>These are certification targets, not constitutional laws.</strong> They trace upward to
    derived and true invariants but must never weaken a true invariant for bounty convenience. This
    view maps each criterion to invariant IDs only — the evidence itself is sourced live from the
    registry and traceability data, not hand-curated here.
  </div>

  <section style="margin:1.5rem 0 1rem">
    <div class="pill-row" style="justify-content:space-between;align-items:baseline;margin-bottom:0.5rem">
      <h2 style="margin:0;border:none;padding:0">Overall readiness</h2>
      <span class="muted" style="font-size:0.85rem">
        <strong style="color:var(--fg);font-size:1rem">{oPct}%</strong> of referenced invariants enforced
      </span>
    </div>
    <div style="display:flex;height:14px;border-radius:7px;overflow:hidden;background:var(--bg-elev2);border:1px solid var(--border)">
      <div style={`width:${pctOf(oEnforced)}%;background:var(--enforced)`} title={`${oEnforced} enforced`}></div>
      <div style={`width:${pctOf(oPartial)}%;background:var(--partial)`} title={`${oPartial} partial`}></div>
      <div style={`width:${pctOf(oDeclared)}%;background:var(--declared)`} title={`${oDeclared} declared`}></div>
      {oUnknown > 0 && <div style={`width:${pctOf(oUnknown)}%;background:#f85149`} title={`${oUnknown} unknown ref`}></div>}
    </div>
    <div class="muted" style="font-size:0.82rem;margin-top:0.45rem;display:flex;justify-content:space-between;flex-wrap:wrap;gap:0.4rem 1.5rem">
      <span>{oEnforced} enforced · {oPartial} partial · {oDeclared} declared{oUnknown > 0 ? ` · ${oUnknown} unknown ref` : ""} (of {oTotal} unique invariants)</span>
      <span>{fullyEvidenced} of {criteria.length} criteria fully evidenced</span>
    </div>
  </section>

  <div class="grid cols-2">
    {criteria.map((c) => {
      const r = readiness(c.invariants);
      return (
        <div class="card" id={c.id} style="scroll-margin-top:70px">
          <div class="pill-row" style="justify-content:space-between">
            <h3 style="margin:0">{c.title}</h3>
            <span class={`badge ${labelClass[r.label] ?? "declared"}`}>{r.label}</span>
          </div>
          <p class="muted" style="font-size:0.88rem">{c.description}</p>
          <div style="display:flex;height:8px;border-radius:4px;overflow:hidden;background:var(--bg-elev2);margin:0.4rem 0 0.7rem">
            <div style={`width:${(r.enforced / r.total) * 100}%;background:var(--enforced)`} title={`${r.enforced} enforced`}></div>
            <div style={`width:${(r.partial / r.total) * 100}%;background:var(--partial)`} title={`${r.partial} partial`}></div>
            <div style={`width:${(r.declared / r.total) * 100}%;background:var(--declared)`} title={`${r.declared} declared`}></div>
          </div>
          <div class="muted" style="font-size:0.78rem;margin-bottom:0.5rem">
            {r.enforced} enforced · {r.partial} partial · {r.declared} declared{r.unknown > 0 ? ` · ${r.unknown} unknown ref` : ""}
          </div>
          <div class="tag-list">
            {c.invariants.map((id) => {
              const rule = ruleById(id);
              return rule
                ? <a class="badge" href={withBase(`/invariants/${id}`)} title={rule.status}>{id}</a>
                : <span class="badge gap" title="not found in registry">{id}?</span>;
            })}
          </div>
        </div>
      );
    })}
  </div>
</Base>
